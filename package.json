{
  "name": "@owlkit/react",
  "version": "0.1.3",
  "description": "Configurable wallet kit for React. Constructor over wagmi, viem, and TanStack Query.",
  "license": "MIT",
  "author": "owlkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfowl/owlkit-react.git"
  },
  "homepage": "https://www.npmjs.com/package/@owlkit/react",
  "bugs": {
    "url": "https://github.com/selfowl/owlkit-react/issues"
  },
  "keywords": [
    "wallet",
    "wagmi",
    "viem",
    "react",
    "ethereum",
    "evm",
    "connect"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "viem": ">=2",
    "wagmi": ">=2"
  },
  "peerDependenciesMeta": {
    "@walletconnect/ethereum-provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "viem": "^2.55.16",
    "wagmi": "^3.7.6"
  },
  "packageManager": "pnpm@11.2.2",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
